# DeepSeek (OpenAI-mos API). Bo‘sh bo‘lsa tizim qoida/shablon bilan ishlaydi.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner
# Fellow rasmlar (EKG/echo) uchun VLM; bo‘sh bo‘lsa DEEPSEEK_MODEL, kalitsiz — shablon
# FELLOW_VISION_MODEL=

# MDT 10-bosqich: MedGemma (tasvir) va Qwen2.5-VL (video). Bo‘sh — shablon
# MEDGEMMA_BASE_URL=http://127.0.0.1:8001
# MEDGEMMA_API_KEY=
# MEDGEMMA_MODEL=google/medgemma-4b-it
# QWEN_VL_BASE_URL=http://127.0.0.1:8002
# QWEN_VL_API_KEY=
# QWEN_VL_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# BioClinicalBERT (1 = HF dan bir marta yuklash; indeks data/processed/rag_index/)
USE_BIOCLINICAL_BERT=1
# RAG_INDEX_DIR=data/processed/rag_index
